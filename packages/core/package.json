{
  "name": "@mitumba/pay",
  "version": "0.1.0",
  "description": "Africa-native payment SDK — provider-neutral headless client for M-Pesa, Airtel Money, card, and more. Zero UI, zero provider knowledge.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mitumba-Ltd/mitumba-pay.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/Mitumba-Ltd/mitumba-pay/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/Mitumba-Ltd/mitumba-pay/issues"
  },
  "keywords": [
    "mpesa",
    "airtel-money",
    "payments",
    "kenya",
    "africa",
    "daraja",
    "paystack",
    "sdk"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "dev": "tsup src/index.ts --format esm,cjs --dts --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src",
    "clean": "rimraf dist .turbo"
  },
  "dependencies": {
    "@mitumba/pay-contract": "0.1.0"
  },
  "devDependencies": {
    "rimraf": "^6.0.1",
    "vitest": "^2.1.1"
  }
}
