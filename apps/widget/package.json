{
  "name": "@mitumba/pay-widget-app",
  "version": "0.1.0",
  "private": true,
  "description": "Hosted Mitumba Pay widget demo (deploys @mitumba/pay-react to pay.mitumba.africa/widget). Not published.",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
